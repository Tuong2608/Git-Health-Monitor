DB_PASSWORD=replace-with-your-local-password
DB_USERNAME=ghm
DB_NAME=git_health_monitor
# Controlled development only; requires a real AnalysisPipeline bean before enabling analysis.
APP_ANALYSIS_ENABLED=false
APP_ANALYSIS_WRITES_ENABLED=false
APP_ANALYSIS_PIPELINE_ENABLED=false
APP_AI_REVIEW_ENABLED=false
APP_AI_REVIEW_PROVIDER_ENABLED=false
APP_AI_REVIEW_PROVIDER_NAME=mistral
APP_AI_REVIEW_PROVIDER_ENDPOINT=https://api.mistral.ai/v1/chat/completions
APP_AI_REVIEW_PROVIDER_MODEL=codestral-latest
APP_AI_REVIEW_PROVIDER_API_KEY=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=5173
STAGING_DOMAIN=localhost
# Local Compose demo: set all three APP_ANALYSIS_* flags true.
# Staging VM (Way 1): set APP_ALLOWED_ORIGINS=https://your-staging-domain.example and run with compose.staging.yaml.
# AI preview/review remains opt-in; review also requires APP_AI_REVIEW_PROVIDER_ENABLED=true and an API key.
